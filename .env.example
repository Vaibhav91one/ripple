# LLM (bring your own key): anthropic | openai | google | openrouter | openai-compatible | ollama
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
MODEL_AGENT=claude-sonnet-5-5
MODEL_EXTRACT=claude-haiku-5-5
DAILY_TOKEN_BUDGET=2000000

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Self-generated secrets (openssl rand -hex 32)
ACK_TOKEN_SECRET=
RESET_TOKEN=

# Optional
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
RESEND_API_KEY=
RESEND_FROM=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPO=            # owner/name of the demo repo that receives issues
RIPPLE_GRAPH=           # graph the API writes to (default: demo)
