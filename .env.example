# Every var in lib/env.ts. Empty = unset. Invalid values warn at boot and fall back to the default.

# LLM (bring your own key)
LLM_PROVIDER=anthropic          # anthropic | openai | google | openrouter | openai-compatible | ollama
LLM_API_KEY=                    # unset = committed fallback cache
LLM_BASE_URL=                   # openai-compatible / ollama / proxy endpoint
MODEL_AGENT=claude-sonnet-5-5   # model for /api/ask
MODEL_EXTRACT=claude-haiku-5-5  # model for extraction
DAILY_TOKEN_BUDGET=2000000      # LLM tokens per day

# FalkorDB
FALKORDB_HOST=localhost         # FalkorDB host
FALKORDB_PORT=6379              # FalkorDB port
FALKORDB_PASSWORD=              # unset = no auth

# Self-generated secrets (openssl rand -hex 32)
ACK_TOKEN_SECRET=               # HMAC key for ack links (required in production)
RESET_TOKEN=                    # guards POST /api/reset (required in production)

# Optional
RESEND_API_KEY=                 # unset = emails render as previews
RESEND_FROM=                    # From address for brief emails
GITHUB_APP_ID=                  # GitHub App that files issues
GITHUB_APP_INSTALLATION_ID=     # installation on the demo repo
GITHUB_APP_PRIVATE_KEY=         # PEM, newlines as \n
GITHUB_REPO=                    # owner/name of the demo repo that receives issues

# Env handling
ENV_STRICT=                     # 1 = throw on invalid env at boot (default: warn and use defaults)
SKIP_ENV_VALIDATION=            # 1 = skip validation (builds)

# Test-only
RIPPLE_GRAPH=                   # graph the API writes to (default: demo)
RIPPLE_NOW=                     # ISO date that overrides the clock

# Future (Phase 0, not read yet)
DATABASE_URL=                   # Postgres (#90)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
RIPPLE_SECRET_KEY=              # encrypts stored secrets
