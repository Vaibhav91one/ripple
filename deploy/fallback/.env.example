# Ripple self-host settings. `cp .env.example .env`. EVERYTHING here is optional: the stack starts with the
# defaults shown. Lines starting with "# " are optional and commented out; uncomment to use.

# --- Core (defaults work; change before exposing the box to the internet) ---
# Local workspace: one writable org "local" seeded with demo data, NO LOGIN (web is bound to 127.0.0.1).
# Comment this line out for the read-only public demo instead. Never use local mode on a public host.
RIPPLE_MODE=local
# Host port for the web UI -> http://localhost:3000
WEB_PORT=3000
# Public base URL, used in links inside messages/emails. Set to your tunnel or domain if you have one.
APP_URL=http://localhost:3000
# Secrets. Left unset, PUBLIC built-in defaults are used: fine on localhost, never on a public host
# (the HTTPS override refuses to start without real values). Passwords: letters and digits only.
# FALKORDB_PASSWORD=
# POSTGRES_PASSWORD=
# ACK_TOKEN_SECRET=        # signs approval/ack links: openssl rand -hex 32
# RESET_TOKEN=             # guards POST /api/reset (wipes and re-seeds the graph; in local mode the `local` workspace)
# Encrypts connector tokens (32-byte base64: openssl rand -base64 32). Unset = derived from ACK_TOKEN_SECRET.
# RIPPLE_SECRET_KEY=

# --- LLM (optional). Unset = Ask answers from the cached answers and /api/health reports llm: fallback ---
# LLM_PROVIDER=openai          # anthropic | openai | google | openrouter | openai-compatible | ollama
# LLM_API_KEY=
# LLM_BASE_URL=                # only for openai-compatible / ollama
# MODEL_AGENT=gpt-5.4          # the agent model
# MODEL_EXTRACT=gpt-5.4-nano   # the cheap extraction model
# DAILY_TOKEN_BUDGET=2000000

# --- GitHub App (optional; see SELF_HOSTING.md. /setup/github arrives in #236) ---
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=      # PEM, with newlines written as \n
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=
# GITHUB_REPO=owner/name

# --- Slack (optional; /setup/slack arrives in #240) ---
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# --- Email (optional): digests and notifications through Resend ---
# RESEND_API_KEY=
# RESEND_FROM=Ripple <ripple@example.com>

# --- Clerk sign-in (optional; for a public host; leave RIPPLE_MODE unset then) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # BUILD-TIME: set before `docker compose up --build`
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET=
# RIPPLE_AUTH=off                      # force the public demo even with Clerk keys
# FALKORDB_TLS=1                       # only for a hosted FalkorDB Cloud (also change FALKORDB_HOST)

# --- HTTPS (optional): docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d ---
# RIPPLE_DOMAIN=ripple.example.com
